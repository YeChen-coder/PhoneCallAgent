# ---- OpenAI ----
OPENAI_API_KEY=sk-...
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Used by scripts/text_chat.py and post-call summaries
TEXT_MODEL=gpt-5-mini
# Only needed for the SIP transport (app/telephony/openai_sip.py)
OPENAI_WEBHOOK_SECRET=

# ---- Twilio ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15550001111
# Set false only for local experiments without a real Twilio signature
TWILIO_VALIDATE_SIGNATURE=true

# Public https URL of this server (ngrok / cloudflared / your deploy), no trailing slash
PUBLIC_BASE_URL=https://example.ngrok-free.app

# ---- App ----
DATABASE_URL=sqlite:///./data/clinic.db
CLINIC_CONFIG_PATH=./clinic.json
KNOWLEDGE_DIR=./knowledge
# Random string; signs the media-stream websocket handshake and protects /admin
APP_SECRET=change-me
ADMIN_TOKEN=change-me-too
SEND_SMS_CONFIRMATIONS=false
SUMMARIZE_CALLS=true

# Turn detection: server_vad (steady latency) or semantic_vad
VAD_TYPE=server_vad
VAD_SILENCE_MS=600
